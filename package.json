{
  "name": "kryoto-desktop",
  "private": true,
  "version": "0.2.32",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "app:dev": "node scripts/dev.mjs",
    "app:dev:plain": "node scripts/dev.mjs -- --no-default-features --features dev-plain-chat-store",
    "app:build": "node scripts/build.mjs",
    "app:build:local": "node scripts/build.mjs --local",
    "brand": "node scripts/brand.mjs",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "vite build --config vite.web.config.ts && node -e \"require('fs').renameSync('dist-web/web.html','dist-web/index.html')\"",
    "web:wasm": "cd ../kryoto-messaging && cargo build -p km-wasm --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir ../kryoto-desktop/src/web/pkg target/wasm32-unknown-unknown/release/km_wasm.wasm"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "@vitejs/plugin-react": "^4.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react-dom": "^19.0.0",
    "playwright": "1.62.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
