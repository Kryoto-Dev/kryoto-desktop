# Optional local development overrides. The app does not load this file
# automatically; export the values in your shell when you need them.

# Browser regression-test server (defaults to http://127.0.0.1:1421).
# DESKTOP_TEST_URL=http://127.0.0.1:1421
# PLAYWRIGHT_BROWSER_CHANNEL=chromium

# macOS: an alternate directory containing Sikarugir wrapper .app bundles.
# KRYOTO_SIKARUGIR_DIR=/Users/you/Applications/Sikarugir

# Keep development builds from registering kryoto:// links by default.
# KRYOTO_REGISTER_SCHEME=1

# Destination for an unsigned local installer.
# KRYOTO_LOCAL_OUT=/Users/you/kryo-builds/kryoto-desktop
